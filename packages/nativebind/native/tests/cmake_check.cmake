# Builds tests/cmake_project the way an app would and checks the result.
#   cmake -DNATIVE_DIR=<native> -DBUILD_DIR=<dir> [-DCXX=<compiler>] -P cmake_check.cmake
foreach(v NATIVE_DIR BUILD_DIR)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "cmake_check: -D${v}=... is required")
  endif()
endforeach()

set(configure_args -S "${NATIVE_DIR}/tests/cmake_project" -B "${BUILD_DIR}" -DNATIVEBIND_NATIVE_DIR=${NATIVE_DIR})
if(CXX)
  list(APPEND configure_args -DCMAKE_CXX_COMPILER=${CXX})
endif()
if(GENERATOR)
  list(APPEND configure_args -G "${GENERATOR}")
endif()
foreach(step "${configure_args}" "--build;${BUILD_DIR}")
  execute_process(COMMAND ${CMAKE_COMMAND} ${step} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "cmake_check: `cmake ${step}` failed:\n${out}\n${err}")
  endif()
endforeach()

# Only the C ABI may be exported: the runtime's and the modules' C++ symbols
# would clash with another nativebind library in the same process. (Standard
# library instantiations stay visible: libstdc++ marks namespace std default
# visibility, and they are identical everywhere.)
file(GLOB lib "${BUILD_DIR}/libcmake_check.so")
if(NOT lib)
  message(FATAL_ERROR "cmake_check: libcmake_check.so was not built")
endif()
find_program(NM nm REQUIRED)
execute_process(COMMAND ${NM} -D --defined-only "${lib}" OUTPUT_VARIABLE syms RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "cmake_check: nm failed")
endif()
string(REPLACE "\n" ";" lines "${syms}")
set(leaked "")
set(abi 0)
foreach(line IN LISTS lines)
  string(REGEX REPLACE "^[0-9a-fA-F]* *[A-Za-z] " "" sym "${line}")
  if(sym MATCHES "^nativebind_[a-z_]+$")
    math(EXPR abi "${abi} + 1")
  elseif(sym MATCHES "10nativebind|6Sensor|6Sample" AND NOT sym MATCHES "^_Z(N|NK|T[ISV])?St|^_ZNK?9__gnu_cxx")
    list(APPEND leaked "${sym}")  # a nativebind or module symbol outside namespace std
  endif()
endforeach()
if(abi EQUAL 0)
  message(FATAL_ERROR "cmake_check: no nativebind_* symbols exported")
endif()
list(LENGTH leaked n)
if(n GREATER 0)
  list(SUBLIST leaked 0 5 some)
  string(REPLACE ";" "\n  " some "${some}")
  message(FATAL_ERROR "cmake_check: ${n} nativebind or module symbols are exported, e.g.\n  ${some}")
endif()
message(STATUS "cmake_check: ok (${abi} nativebind_* functions exported, no C++ symbols of nativebind or the modules)")
